# ============================================================
# KAJ SHOHAYOK — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── PostgreSQL (Required) ─────────────────────────────────
# Local:  postgresql://USER:PASSWORD@localhost:5432/kaj_shohayok
# Cloud:  Use Neon free tier → https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kaj_shohayok"


# ── MongoDB (Required) ────────────────────────────────────
# Local:  mongodb://MONGO_ROOT_USER:MONGO_ROOT_PASSWORD@localhost:27017/DATABASE?authSource=admin
# Cloud:  Use MongoDB Atlas free tier (M0) → https://mongodb.com/atlas
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kaj_shohayok?appName=Cluster0"

# ── Clerk Authentication (Required) ───────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_secret_key_here"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Clerk redirect URLs (keep these defaults unless you change routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── Google Gemini AI (Optional — enables AI features) ─────
# Get API key from: https://aistudio.google.com/app/apikey
# Without this, AI endpoints return sensible mock responses.
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Redis (Optional — enables real-time pub/sub at scale) ─
# Local Docker: redis://:PASSWORD@localhost:6379
# Cloud:  Use Upstash free tier → https://upstash.com
REDIS_URL="redis://:PASSWORD@localhost:6379"



# ── Vercel Deployment (CI/CD only — set as GitHub Secrets) ─
# Required for the GitHub Actions deploy job:
# VERCEL_TOKEN        → Vercel account token
# VERCEL_ORG_ID       → Found in Vercel project settings
# VERCEL_PROJECT_ID   → Found in Vercel project settings

# ── Admin Access ──────────────────────────────────────────
# Sign up at /sign-up with these credentials to get full Admin access.
# The email below is automatically assigned the Admin role on first sign-up.
ADMIN_EMAIL="admin@kajshohayok.com"
ADMIN_PASSWORD="Admin@KS2025!"

# ── App Config ────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS_PER_MINUTE="60"

# ── Docker Compose variables (used in docker-compose.yml) ─
POSTGRES_USER="kaj_user"
POSTGRES_PASSWORD="kaj_password"
POSTGRES_DB="kaj_shohayok"
MONGO_ROOT_USER="admin"
MONGO_ROOT_PASSWORD="mongo_password"
MONGO_DATABASE="kaj_shohayok"
REDIS_PASSWORD="redis_password"
